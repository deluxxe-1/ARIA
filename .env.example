# ============================================================
# ARIA — Variables de entorno — PRODUCCIÓN (Ubuntu Server RTX 3060)
# Copiar a .env (NUNCA versionar el .env real) y revisar cada valor
# ============================================================

# --- Identidad y entorno --------------------------------------
ARIA_APP_NAME=ARIA
ARIA_ENV=production
# 0.0.0.0 obligatorio en servidor para escuchar por LAN (no localhost)
ARIA_HOST=0.0.0.0
ARIA_PORT=8000

# --- Ollama runtime (GPU RTX 3060) ----------------------------
# Servicio systemd propio en 127.0.0.1 (NO exponer a LAN)
ARIA_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Modelos dual-LLM (ambos Q4_K_M ≈ 11GB VRAM total)
ARIA_PLANNER_MODEL=qwen3:8b
ARIA_CODER_MODEL=qwen2.5-coder:7b

# --- Persistencia --------------------------------------------
ARIA_SQLITE_PATH=/opt/aria/storage/aria.db
ARIA_WORKSPACE_DIR=/opt/aria/workspaces/projects
ARIA_VOICE_PROFILES_DIR=/opt/aria/storage/voice_profiles
ARIA_VOICE_OUTPUTS_DIR=/opt/aria/storage/voice_outputs

# --- Seguridad / Restricciones --------------------------------
# ⚠️ PRODUCCIÓN: MANTENER EN FALSE. Shell tool solo para admin local.
ARIA_ALLOW_SHELL=false
ARIA_MAX_TOOL_ITERATIONS=4

# --- Voz (STT local faster-whisper GPU) -----------------------
ARIA_VOICE_BACKEND=xttsv2
ARIA_STT_BACKEND=faster-whisper
ARIA_ENABLE_NATIVE_APPS=true

# --- Seguridad HTTP (CORS) ------------------------------------
ARIA_ENABLE_CORS=true
# Recomendado en LAN: enumera explícitamente IPs/FQDNs en vez de "*"
#   ARIA_CORS_ORIGINS=["http://192.168.1.100:8080","http://aria.local"]
ARIA_CORS_ORIGINS=["*"]

# --- Autenticación X-ARIA-Key ---------------------------------
# ⚠️ PRODUCCIÓN OBLIGATORIO activar y poner clave aleatoria 32+ bytes
#   openssl rand -hex 32   → genera clave segura
ARIA_ENABLE_API_KEY=true
ARIA_API_KEY=PONER_CLAVE_SEGURA_GENERADA_CON_OPENSSL_RAND_HEX_32

# --- Rate limit por IP ----------------------------------------
ARIA_ENABLE_RATE_LIMIT=true
# 30/min por IP conservador para RTX 3060 (≈ 40-50 tok/s)
ARIA_RATE_LIMIT_PER_MINUTE=30

# --- Límites upload voz ---------------------------------------
ARIA_VOICE_MAX_UPLOAD_MB=50
ARIA_VOICE_ALLOWED_EXTENSIONS=["wav","mp3","m4a","ogg"]

# --- Limpieza TTL --------------------------------------------
ARIA_VOICE_OUTPUTS_TTL_HOURS=48
ARIA_AUTO_CLEANUP_ON_STARTUP=true

# --- Migraciones automáticas Alembic -------------------------
ARIA_AUTO_MIGRATE=true
